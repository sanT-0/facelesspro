# ─────────────────────────────────────────────────────────────
# FacelessPro — local development
# Everything here except DATABASE_URL is optional: the app runs
# with zero paid keys and degrades to local / heuristic engines.
# ─────────────────────────────────────────────────────────────

# --- core ------------------------------------------------------------------
DATABASE_URL=postgresql://faceless:faceless@127.0.0.1:5433/faceless
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001
MEDIA_SERVICE_URL=http://127.0.0.1:8000
PLAN=selfhost                 # selfhost = unlimited credits, ledger still records unit costs

# --- storage ---------------------------------------------------------------
STORAGE=disk                  # disk | s3
DATA_DIR=.data
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- engine chains (first healthy adapter wins, left to right) -------------
PLANNER=cloudflare,groq,ollama,heuristic
IMAGE=cloudflare,pollinations,comfyui,procedural
STYLE=vlm,heuristic
TTS=edge,indicf5,piper
ASR=whisper-local,cloudflare

# --- optional credentials --------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188

# --- limits ----------------------------------------------------------------
MAX_SCRIPT_CHARS=50000
MAX_VIDEO_MINUTES=30
MAX_SCENES=120
DEFAULT_RESOLUTION=1080
IMAGE_CONCURRENCY=3
TTS_CONCURRENCY=6

# --- media service ---------------------------------------------------------
MEDIA_DATA_DIR=./services/media/.data
FONTCONFIG_FILE=./packages/art/fonts/fonts.conf
LOG_SCRIPTS=0

# --- synthesis cache -------------------------------------------------------
# Raw provider audio per (engine, voice, text), before trimming/stitching.
# On by default; a retried video then costs ffmpeg time, not network.
TTS_CACHE=1
# TTS_CACHE_DIR=./services/media/.data/cache
TTS_CACHE_MAX_MB=2048

# --- paid upgrades (never required) ---------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
