# =============================================================================
# FacelessPro - local development environment
#
#   cp .env.example .env
#
# Only DATABASE_URL matters to start. Everything else has a working default and
# an empty credential means "use the free engine that needs no key". Cost levers
# and limits are explained in docs/10-operations.md.
#
# `@facelesspro/db`'s `loadEnv()` loads this file for Node. The Python media
# service reads the same names from its own process environment, so export them
# or run it from the repo root.
# =============================================================================

# --- core --------------------------------------------------------------------
# Postgres from docker-compose (host port 5433, not 5432).
DATABASE_URL=postgresql://faceless:faceless@127.0.0.1:5433/faceless
PORT=3001

# pg-boss's schema. Changing it means creating the queues there: the api's
# /health queue probe reads this schema's `queue` table, so a typo shows up as
# `"queue":"error"` instead of a worker that silently consumes nothing.
# PGBOSS_SCHEMA=pgboss

# Stable public origin. Completed renders must stay reachable without auth.
PUBLIC_BASE_URL=http://127.0.0.1:3001
MEDIA_SERVICE_URL=http://127.0.0.1:8000

# selfhost = unlimited credits; the ledger still records unit costs.
PLAN=selfhost

# --- storage -----------------------------------------------------------------
# disk | s3
STORAGE=disk
DATA_DIR=.data
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- engine chains -----------------------------------------------------------
# First healthy adapter wins, left to right; a failed one degrades to the next.
# Read from P2 (planner), P3 (image/style), P1 (tts) and P6 (asr) onwards.
PLANNER=cloudflare,groq,ollama,heuristic
IMAGE=cloudflare,pollinations,comfyui,procedural
STYLE=vlm,heuristic
TTS=edge,indicf5,piper
ASR=whisper-local,cloudflare

# --- optional credentials ----------------------------------------------------
# Leave empty for the free path. None of these is required to produce a video.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188

# --- limits ------------------------------------------------------------------
# These cap spend and render time; they are not a product tier.
MAX_SCRIPT_CHARS=50000
MAX_VIDEO_MINUTES=30
MAX_SCENES=120
DEFAULT_RESOLUTION=1080
IMAGE_CONCURRENCY=3
TTS_CONCURRENCY=6

# --- media service (services/media) ------------------------------------------
MEDIA_DATA_DIR=./services/media/.data

# P4 ships packages/art/fonts/fonts.conf for libass; until then libass uses the
# system font list.
# FONTCONFIG_FILE=./packages/art/fonts/fonts.conf

# 1 would write narration text to logs. Off: user scripts are private.
LOG_SCRIPTS=0

# --- synthesis cache ---------------------------------------------------------
# Raw provider audio per (engine, voice, text), stored before trimming and
# stitching. On by default: a retried video then costs ffmpeg time, not network.
TTS_CACHE=1
# TTS_CACHE_DIR=./services/media/.data/cache
TTS_CACHE_MAX_MB=2048

# --- scripts and tests -------------------------------------------------------
# `npm run sample:tts`: interpreter, port and voice pair for the listening clips.
# PYTHON=python
# TTS_PORT=8791
# TTS_PAIR=pallavi-neerja

# `pytest services/media` with the live Microsoft voice list / a real synthesis.
# RUN_LIVE=1

# --- paid upgrades (never required) -----------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
