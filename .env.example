GEMINI_API_KEY=

# AI images (procedural renderer is used when empty).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Publish-mode TTS (default is the free edge-tts service).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
