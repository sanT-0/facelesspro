# =============================================================================
# FacelessPro - local development environment
#
#   cp .env.example .env
#
# Only DATABASE_URL matters to start. Everything else has a working default and
# an empty credential means "use the free engine that needs no key". Cost levers
# and limits are explained in docs/10-operations.md.
#
# `@facelesspro/db`'s `loadEnv()` loads this file for Node. The Python media
# service reads the same names from its own process environment, so export them
# or run it from the repo root.
# =============================================================================

# --- core --------------------------------------------------------------------
# Postgres from docker-compose (host port 5433, not 5432).
DATABASE_URL=postgresql://faceless:faceless@127.0.0.1:5433/faceless
PORT=3001

# pg-boss's schema. Changing it means creating the queues there: the api's
# /health queue probe reads this schema's `queue` table, so a typo shows up as
# `"queue":"error"` instead of a worker that silently consumes nothing.
# PGBOSS_SCHEMA=pgboss

# Stable public origin of the deployment — the URL a person opens in a browser.
# It is used for both `editorUrl` and `videoUrl`, so it must be an origin that
# serves the studio AND proxies `/v1/*` + `/files/*` to the api. The compose
# stack's web container does both at :3003; `npm run dev:web` does both at
# :3000. Only point this at :3001 if the api is the only front door you expose.
PUBLIC_BASE_URL=http://localhost:3003
MEDIA_SERVICE_URL=http://127.0.0.1:8000

# The workspace's plan lives in Postgres (`workspace.plan_id`, seeded as
# `selfhost`). There is no PLAN env var: credits/limits are read from the row.
# selfhost = unlimited credits; the ledger still records unit costs.

# --- storage -----------------------------------------------------------------
# Only the local disk backend is implemented today. `STORAGE` and the `S3_*`
# names below are reserved for the S3/CDN backend in docs/10 §2 and are not read
# yet; setting them changes nothing.
# STORAGE=disk
DATA_DIR=.data
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- engine chains -----------------------------------------------------------
# First healthy adapter wins, left to right; a failed one degrades to the next.
# An adapter whose credentials/workflow are unset is skipped with a warning (not
# counted as degradation). IMAGE unset, or nothing runnable, = procedural only.
# Read from P2 (planner), P3 (image/style), P1 (tts) and P6 (asr) onwards.
PLANNER=cloudflare,groq,ollama,heuristic
IMAGE=cloudflare,pollinations,comfyui,procedural
STYLE=cloudflare,gemini,heuristic
# Default chain keeps edge for dev/self-host; public deployments MUST set
# TTS_REQUIRE_LICENSED=1 to drop edge and fail closed if no licensed engine starts.
# Azure is the licensed production path (~$15/1M chars + 0.5M free/month) and uses
# the same ta-IN-* voice ids. IndicF5/Piper have no adapter yet and are skipped.
TTS=edge,azure,indicf5,piper
# ASR has no chain switch: the worker calls the media service, which runs
# faster-whisper locally (`ASR_MODEL`, default large-v3-turbo). A Cloudflare ASR
# adapter is not wired yet.

# Public deployments: set to 1 to forbid the unlicensed edge engine. The service
# will refuse to start unless a licensed engine (azure) can be initialised.
TTS_REQUIRE_LICENSED=0

# --- optional credentials ----------------------------------------------------
# Leave empty for the free path. None of these is required to produce a video.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
POLLINATIONS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188

# Docker: the compose stack reads this same .env for interpolation. Inside a
# container `127.0.0.1` is the container, so `docker-compose.yml` defaults
# Ollama/ComfyUI to the host gateway. Override these only when the service runs
# on the compose network instead of the host.
# OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# COMFYUI_URL_DOCKER=http://host.docker.internal:8188

# Webhook signing. When set, completed/failed deliveries carry
# `X-Faceless-Signature: sha256=<hmac>`. Empty = no signature header.
# WEBHOOK_SECRET=

# Azure Speech (licensed TTS production path, P1). Required when
# TTS_REQUIRE_LICENSED=1 or when TTS chain includes 'azure' and you want it to work.
# Get a key from the Azure portal → Speech Services resource.
# Pricing: ~$15 / 1M characters, 0.5M free/month (prebuilt neural).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local model writes English scene descriptions while the heuristic keeps every
# cut and Tamil sentence (`ollama`, or leave unset for deterministic prompts).
# The model must already be pulled (`ollama pull llama3.1:8b`). Qwen3's thinking
# mode returns empty `message.content` with `format: json`; use a non-thinking
# model until the adapter sends `think: false`.
# PLANNER_DESCRIBE=ollama
# OLLAMA_DESCRIBE_MODEL=qwen2.5:7b-instruct

# Local ComfyUI workflow (API format) and its single image output node.
# COMFYUI_WORKFLOW=fixtures/workflows/comfyui-sd15-api.json
# COMFYUI_OUTPUT_NODE=10
# COMFYUI_TIMEOUT_MS=900000

# Optional per-adapter planner overrides (defaults shown):
# CLOUDFLARE_PLANNER_MODEL=@cf/meta/llama-3.1-8b-instruct
# GROQ_PLANNER_MODEL=llama-3.1-8b-instant
# OLLAMA_PLANNER_MODEL=llama3.1:8b

# Optional Cloudflare image overrides (defaults shown). Flux Schnell shares the
# Cloudflare account/token above; provider output is normalized to RGB PNG.
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# CLOUDFLARE_IMAGE_TIMEOUT_MS=120000
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/image
# POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# POLLINATIONS_IMAGE_TIMEOUT_MS=120000

# Local ComfyUI. Export a workflow in API format and replace its prompt,
# negative, seed, width and height inputs with the five __FACELESSPRO_*__
# placeholders shown in fixtures/workflows/comfyui-sdxl-api.json. The example
# checkpoint is not bundled; edit the copied workflow to match your install.
# COMFYUI_WORKFLOW=fixtures/workflows/comfyui-sdxl-api.json
# COMFYUI_OUTPUT_NODE=9
# COMFYUI_TIMEOUT_MS=300000
# COMFYUI_POLL_INTERVAL_MS=500

# Optional art-style vision overrides (defaults shown). Vision shares the
# Cloudflare account/token and the Gemini key above; the heuristic needs none.
# CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
# GEMINI_VISION_MODEL=gemini-2.0-flash
# CLOUDFLARE_VISION_TIMEOUT_MS=60000
# GEMINI_VISION_TIMEOUT_MS=60000

# --- limits ------------------------------------------------------------------
# These caps are compile-time constants in packages/contracts/src/common.ts
# (`MAX_SCRIPT_CHARS`, `MAX_VIDEO_MINUTES`, `MAX_SCENES`). They are NOT read
# from the environment; change the constants and rebuild.
# IMAGE_CONCURRENCY / TTS_CONCURRENCY are reserved and not read yet: P5.3
# processes scenes sequentially so each quality check sees every prior frame.

# Self-host records one image unit per started block of 20 scenes at zero cost;
# a paid plan supplies its own unit price.
# IMAGE_UNIT_COST=0

# One enabled caption track costs one subtitles unit. The committed reference
# price is 20 credits; selfhost workspaces are unlimited but retain this ledger
# value for cost explainability.
# SUBTITLE_UNIT_COST=20

# One render bills `narration minutes x price` at 30 fps; 60 fps bills double.
# The price below is the committed reference value (10 credits/minute).
# RENDER_UNIT_COST=10

# --- media service (services/media) ------------------------------------------
MEDIA_DATA_DIR=./services/media/.data
# `create-vocal` calls MEDIA_SERVICE_URL/synthesize. A 3-minute narration is a
# long request; the worker gives it 10 minutes by default.
# MEDIA_TTS_TIMEOUT_MS=600000
# `create-scenes` calls MEDIA_SERVICE_URL/transcribe for an uploaded voiceover;
# CPU whisper can be slower than real time, so it gets the same 10 minutes.
# MEDIA_ASR_TIMEOUT_MS=600000
# Default narration pair when the request omits voiceId. One speaker reads both
# languages (docs/05 §3.5), so this is a pair id, never a bare engine voice id;
# the options and their listening clips are documented under scripts/tests.
# Self-host records billable characters at zero cost; a paid plan supplies its
# own unit price.
# TTS_UNIT_COST=0

# P4 ships packages/art/fonts/fonts.conf for libass; until then libass uses the
# system font list.
# FONTCONFIG_FILE=./packages/art/fonts/fonts.conf

# 1 would write narration text to logs. Off: user scripts are private.
LOG_SCRIPTS=0
# debug | info | warn | error. LOG_STACKS=1 adds stack traces to error lines.
# LOG_LEVEL=info
# LOG_STACKS=0

# --- synthesis cache ---------------------------------------------------------
# Raw provider audio per (engine, voice, text), stored before trimming and
# stitching. On by default: a retried video costs ffmpeg time, not network.
TTS_CACHE=1
# TTS_CACHE_DIR=./services/media/.data/cache
TTS_CACHE_MAX_MB=2048

# 1 shortens the 60-250 ms silences the provider leaves between words to 50 ms
# (2 x 25 ms, so a consonant is never clipped), and the 250-1200 ms full-stop
# pauses to TTS_SENTENCE_PAUSE_MS. 0 reproduces the provider's own delivery, for
# A/B listening.
TTS_PAUSE_COMPRESSION=1
# Total length of a provider full stop inside a run (edge-tts leaves ~950 ms).
# 320 is a sentence beat; 0 keeps the provider's own break.
TTS_SENTENCE_PAUSE_MS=320

# --- scripts and tests -------------------------------------------------------
# `npm run sample:tts`: interpreter, port and voice pair for the listening
# clips. A pair is ONE speaker reading both languages — `valluvar` (male,
# default) or a female voice: `pallavi` (default), `seraphina`, `vivienne`,
# `thalita` (all approved on fresh text). The two-voice pairs were rejected by
# ear. Output goes to `samples/tts/<pair>/`, so each voice keeps its own set.
# PYTHON=python
# TTS_PORT=8791
# TTS_PAIR=valluvar
# TTS_PAIR=pallavi
# TTS_PAIR=seraphina
# TTS_PAIR=vivienne
# TTS_PAIR=thalita
# Override the output dir only for a throwaway render, never for an approved set.
# TTS_OUT_DIR=samples/tts/auditions/rate-pause

# `pytest services/media` with the live Microsoft voice list / a real synthesis.
# RUN_LIVE=1

# --- paid upgrades (never required) -----------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
