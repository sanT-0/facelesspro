# =============================================================================
# FacelessPro - local development environment
#
#   cp .env.example .env
#
# Only DATABASE_URL matters to start. Everything else has a working default and
# an empty credential means "use the free engine that needs no key". Cost levers
# and limits are explained in docs/10-operations.md.
#
# `@facelesspro/db`'s `loadEnv()` loads this file for Node. The Python media
# service reads the same names from its own process environment, so export them
# or run it from the repo root.
# =============================================================================

# --- core --------------------------------------------------------------------
# Postgres from docker-compose (host port 5433, not 5432).
DATABASE_URL=postgresql://faceless:faceless@127.0.0.1:5433/faceless
PORT=3001

# pg-boss's schema. Changing it means creating the queues there: the api's
# /health queue probe reads this schema's `queue` table, so a typo shows up as
# `"queue":"error"` instead of a worker that silently consumes nothing.
# PGBOSS_SCHEMA=pgboss

# Stable public origin. Completed renders must stay reachable without auth.
PUBLIC_BASE_URL=http://127.0.0.1:3001
MEDIA_SERVICE_URL=http://127.0.0.1:8000

# selfhost = unlimited credits; the ledger still records unit costs.
PLAN=selfhost

# --- storage -----------------------------------------------------------------
# disk | s3
STORAGE=disk
DATA_DIR=.data
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- engine chains -----------------------------------------------------------
# First healthy adapter wins, left to right; a failed one degrades to the next.
# An adapter whose credentials/workflow are unset is skipped with a warning (not
# counted as degradation). IMAGE unset, or nothing runnable, = procedural only.
# Read from P2 (planner), P3 (image/style), P1 (tts) and P6 (asr) onwards.
PLANNER=cloudflare,groq,ollama,heuristic
IMAGE=cloudflare,pollinations,comfyui,procedural
STYLE=cloudflare,gemini,heuristic
TTS=edge,indicf5,piper
ASR=whisper-local,cloudflare

# --- optional credentials ----------------------------------------------------
# Leave empty for the free path. None of these is required to produce a video.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
POLLINATIONS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188

# Optional per-adapter planner overrides (defaults shown):
# CLOUDFLARE_PLANNER_MODEL=@cf/meta/llama-3.1-8b-instruct
# GROQ_PLANNER_MODEL=llama-3.1-8b-instant
# OLLAMA_PLANNER_MODEL=llama3.1:8b

# Optional Cloudflare image overrides (defaults shown). Flux Schnell shares the
# Cloudflare account/token above; provider output is normalized to RGB PNG.
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# CLOUDFLARE_IMAGE_TIMEOUT_MS=120000
# POLLINATIONS_BASE_URL=https://gen.pollinations.ai/image
# POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
# POLLINATIONS_IMAGE_TIMEOUT_MS=120000

# Local ComfyUI. Export a workflow in API format and replace its prompt,
# negative, seed, width and height inputs with the five __FACELESSPRO_*__
# placeholders shown in fixtures/workflows/comfyui-sdxl-api.json. The example
# checkpoint is not bundled; edit the copied workflow to match your install.
# COMFYUI_WORKFLOW=fixtures/workflows/comfyui-sdxl-api.json
# COMFYUI_OUTPUT_NODE=9
# COMFYUI_TIMEOUT_MS=300000
# COMFYUI_POLL_INTERVAL_MS=500

# Optional art-style vision overrides (defaults shown). Vision shares the
# Cloudflare account/token and the Gemini key above; the heuristic needs none.
# CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
# GEMINI_VISION_MODEL=gemini-2.0-flash
# CLOUDFLARE_VISION_TIMEOUT_MS=60000
# GEMINI_VISION_TIMEOUT_MS=60000

# --- limits ------------------------------------------------------------------
# These cap spend and render time; they are not a product tier.
MAX_SCRIPT_CHARS=50000
MAX_VIDEO_MINUTES=30
MAX_SCENES=120
DEFAULT_RESOLUTION=1080
IMAGE_CONCURRENCY=3
TTS_CONCURRENCY=6

# --- media service (services/media) ------------------------------------------
MEDIA_DATA_DIR=./services/media/.data

# P4 ships packages/art/fonts/fonts.conf for libass; until then libass uses the
# system font list.
# FONTCONFIG_FILE=./packages/art/fonts/fonts.conf

# 1 would write narration text to logs. Off: user scripts are private.
LOG_SCRIPTS=0

# --- synthesis cache ---------------------------------------------------------
# Raw provider audio per (engine, voice, text), stored before trimming and
# stitching. On by default: a retried video costs ffmpeg time, not network.
TTS_CACHE=1
# TTS_CACHE_DIR=./services/media/.data/cache
TTS_CACHE_MAX_MB=2048

# 1 shortens the 60-250 ms silences the provider leaves between words to 50 ms
# (2 x 25 ms, so a consonant is never clipped). Sentence breaks are untouched.
# 0 reproduces the provider's own word-by-word delivery, for A/B listening.
TTS_PAUSE_COMPRESSION=1

# --- scripts and tests -------------------------------------------------------
# `npm run sample:tts`: interpreter, port and voice pair for the listening
# clips. A pair is ONE speaker reading both languages — `valluvar` (male,
# default) or a female voice: `pallavi` (default), `seraphina`, `vivienne`,
# `thalita` (all approved on fresh text). The two-voice pairs were rejected by
# ear. Output goes to `samples/tts/<pair>/`, so each voice keeps its own set.
# PYTHON=python
# TTS_PORT=8791
# TTS_PAIR=valluvar
# TTS_PAIR=pallavi
# TTS_PAIR=seraphina
# TTS_PAIR=vivienne
# TTS_PAIR=thalita
# Override the output dir only for a throwaway render, never for an approved set.
# TTS_OUT_DIR=samples/tts/auditions/rate-pause

# `pytest services/media` with the live Microsoft voice list / a real synthesis.
# RUN_LIVE=1

# --- paid upgrades (never required) -----------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
