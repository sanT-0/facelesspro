{
  "name": "facelesspro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gate": "npm run typecheck && npm run lint && npm run test",
    "test:media": "python -m pytest services/media -q",
    "tts:audit": "tsx scripts/audit-transliteration.ts",
    "sample:tts": "tsx scripts/sample-tts.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "key:create": "tsx packages/db/src/create-api-key.ts",
    "dev:api": "npm run dev --workspace @facelesspro/api",
    "dev:worker": "npm run dev --workspace @facelesspro/worker",
    "ping": "tsx scripts/ping.ts",
    "e2e:keys": "tsx scripts/e2e-api-keys.ts",
    "e2e:auth": "tsx scripts/e2e-auth-scope.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
