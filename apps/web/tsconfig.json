{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "dom"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@facelesspro/core": ["../../packages/core/src/index.ts"],
      "@facelesspro/contracts": ["../../packages/contracts/src/index.ts"],
      "@facelesspro/db": ["../../packages/db/src/index.ts"],
      "@facelesspro/queue": ["../../packages/queue/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
